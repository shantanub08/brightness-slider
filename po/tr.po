msgstr "Normal arka ışık kontrolünü kullan."

#: schemas/org.gnome.shell.extensions.brightness-slider.gschema.xml
msgid "Monitors."
msgstr "Monitörler."

#: schemas/org.gnome.shell.extensions.brightness-slider.gschema.xml
